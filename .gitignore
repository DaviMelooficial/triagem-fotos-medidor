# Material de apoio e dados reais: nunca vão para o repositório público
guias/
dados/
resultados_locais/

# Segredos e ambiente local
.env
.venv/

# Lixo do Python e do macOS
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Pacotes compartilhados em privado (ex.: guias.zip)
*.zip

# Monitoramento: rastro local das requisições e banco DuckDB das métricas (gerados ao rodar)
logs/*
!logs/.gitkeep
monitoring/*.duckdb
monitoring/*.duckdb.wal

# Saída padrão dos scripts de análise e planilha (os resultados da entrega ficam em monitoring/analise/)
monitoring/saida/
