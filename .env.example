# Variáveis opcionais. Sem elas, o projeto usa os valores mostrados abaixo.
# Para mudar, exporte no terminal antes de rodar (ex.: export OLLAMA_MODELO=qwen2.5vl:3b).

# Modelo de visão usado no Ollama
OLLAMA_MODELO=qwen3-vl:4b
# Endereço do servidor Ollama
OLLAMA_HOST=http://localhost:11434
# Quantas respostas pedir ao modelo para a votação de confiança
N_RESPOSTAS=3
