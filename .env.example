# Variáveis opcionais. Vazias ou ausentes, o projeto usa o padrão indicado no comentário.
# Para mudar, exporte no terminal antes de rodar (ex.: export OLLAMA_MODELO=qwen2.5vl:3b).

# Modelo de visão usado no Ollama (padrão: qwen3-vl:4b)
OLLAMA_MODELO=
# Endereço do servidor Ollama (padrão: http://localhost:11434)
OLLAMA_HOST=
# Quantas respostas pedir ao modelo para a votação de confiança (padrão: 3; use número ímpar)
N_RESPOSTAS=
