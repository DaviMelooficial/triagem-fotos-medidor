# Modelo: o docker-compose troca PORTA_API pela porta do serviço (padrão 3000) antes de subir.
global:
  scrape_interval: 5s # coleta o /metrics a cada 5 s
  evaluation_interval: 5s

rule_files:
  - /etc/prometheus/regras.yml

scrape_configs:
  - job_name: triagem-medidor
    metrics_path: /metrics
    static_configs:
      - targets: ["host.docker.internal:PORTA_API"] # o serviço roda no host, fora do Docker
